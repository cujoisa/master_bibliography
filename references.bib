@ARTICLE{Nelson2026-bw,
  title     = "Network divergence analysis identifies adaptive gene modules and
               two orthogonal vulnerability axes in pancreatic cancer",
  author    = "Nelson, Brian and Delgado-Coka, Lyanne and Marchenko, Natalia and
