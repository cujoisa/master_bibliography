@ARTICLE{Pishvaian2020-mm,
  title     = "Overall survival in patients with pancreatic cancer receiving
               matched therapies following molecular profiling: a retrospective
               analysis of the Know Your Tumor registry trial",
  author    = "Pishvaian, Michael J and Blais, Edik M and Brody, Jonathan R and
               Lyons, Emily and DeArbeloa, Patricia and Hendifar, Andrew and
