@ARTICLE{Liu2026-sr,
  title     = "A unified framework for defining and analyzing spatial niches in
               spatial omics data analysis",
  author    = "Liu, Pan and Li, Jingyi Jessica",
  journal   = "Nature Genetics",
  publisher = "Springer Science and Business Media LLC",
  pages     = "1--9",
  abstract  = "The term 'spatial niche' is widely used in spatial omics analyses
               but is inconsistently defined across studies. We survey the
               literature and find that it most commonly refers to the following
               three distinct concepts: (1) a proximity-based neighborhood
               around an anchor cell or spatial spot; (2) a computationally
               derived spatial domain comprising spatially proximal spots or
               cells with shared molecular features; and (3) a biologically
               grounded ecosystem comprising cellular and noncellular components
               that support resident cells. We organize existing studies under
               this taxonomy and distinguish two main analytical roles-niches as
               spot-level covariates for modeling local context, and niches as
               spot clusters for within-niche and between-niche compositional
               and molecular analyses. To reduce ambiguity, we recommend
               reserving 'niche' for biological ecosystems while using 'spatial
               neighborhood' and 'spatial domain' for the corresponding
               computational constructs. We also provide a practical decision
               framework to help researchers align niche definitions and
               analytical strategies with the biological questions at hand.",
  month     =  "13~" # nov,
  year      =  2026,
  doi       = "10.1038/s41588-026-02813-6",
  language  = "en"
}

