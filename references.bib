@ARTICLE{Hassan2026-hr,
  title     = "Artificial intelligence strategies for predicting kinase
               inhibitor resistance: A comprehensive review of methods,
               challenges, and future perspectives",
  author    = "Hassan, Faris and Deifallah, Mohanad Ali and Zaghloul, Alaa and
