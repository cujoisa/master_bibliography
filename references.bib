}

@ARTICLE{Anastasia2025-ml,
  title    = "Stroma gene signature predicts responsiveness to chemotherapy in
              pancreatic ductal adenocarcinoma patient-derived xenograft models",
  author   = "Anastasia, Alessia and Formenti, Laura and Ostano, Paola and
              Minoli, Lucia and Resovi, Andrea and Morosi, Lavinia and
